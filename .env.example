# Django Security & Core
SECRET_KEY=your-secure-django-secret-key-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,api.medtrax.me

# Database (PostgreSQL)
POSTGRES_DB=medtraxdata
POSTGRES_USER=medtraxadmin
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://medtraxadmin:your_secure_db_password@db:5432/medtraxdata
DB_SSL_REQUIRE=False

# Redis & Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
RUNNING_IN_DOCKER=false

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=noreply@medtrax.me
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_specific_password

# JWT & Throttles
JWT_ACCESS_TOKEN_LIFETIME_HOURS=1
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30
OTP_EXPIRY_MINUTES=3
OTP_MAX_ATTEMPTS=3
LOGIN_MAX_ATTEMPTS=5
OTP_LOCK_DURATION_MINUTES=10
LOGIN_LOCK_DURATION_MINUTES=15

# App & Logging
LOG_LEVEL=INFO
TIME_ZONE=UTC
PAGE_SIZE=50
