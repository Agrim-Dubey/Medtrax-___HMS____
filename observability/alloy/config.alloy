// Grafana Alloy Configuration for MedTrax Observability (Logs & Traces)

// 1. Discover running Docker containers on the host Docker daemon
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// 2. Relabel and extract clean metadata labels (service name, container name)
discovery.relabel "medtrax_logs" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/medtrax-(.*)"
    target_label  = "service"
  }
}

// 3. Tail stdout and stderr logs from discovered containers
loki.source.docker "medtrax" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.medtrax_logs.output
  forward_to = [loki.write.local_loki.receiver]
}

// 4. Forward collected logs to the Loki push API
loki.write "local_loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// 5. OpenTelemetry trace receiver: accepts OTLP traces from application services
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

// 6. Forward received traces to the Grafana Tempo distributor
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}
